# allesuntereinemdach.ch – Hostpoint (Apache)

# No directory listings
Options -Indexes

# Use https://allesuntereinemdach.ch without www
# (Hostpoint already redirects http to https.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://allesuntereinemdach.ch%{REQUEST_URI} [R=301,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Block files that should never be served
<FilesMatch "^(\.|render\.yaml$)">
  Require all denied
</FilesMatch>
